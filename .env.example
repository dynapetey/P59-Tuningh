# Google AI Studio and Firebase API Configurations
# Enter these keys in the Secrets panel in Google AI Studio to make them accessible.

# 1. Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Project Configuration (Auth & Firestore)
# You can get these values from your Firebase Project Settings under General -> Your Apps.
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
